APP_ENV=local
LOG_LEVEL=INFO

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=shop

# Owner role: creates schema and seeds data. Used only by init scripts.
POSTGRES_ADMIN_USER=guardsql_admin
POSTGRES_ADMIN_PASSWORD=change_me_admin

# Read-only role: the ONLY role the query executor uses.
POSTGRES_RO_USER=guardsql_ro
POSTGRES_RO_PASSWORD=change_me_ro

POSTGRES_SCHEMA=shop
POOL_MAX_SIZE=5

# Guardrails
RESTRICTED_COLUMNS=email,phone,date_of_birth,salary
DEFAULT_ROW_LIMIT=100
MAX_ROW_LIMIT=1000
STATEMENT_TIMEOUT_MS=3000
MAX_PLAN_COST=50000

# LLM: fake | ollama | gemini
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5-coder:7b
OLLAMA_NUM_CTX=4096

# Only needed when LLM_PROVIDER=gemini. Put the real key in .env, never here.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# M6: hallucination detection
CONSISTENCY_SAMPLES=1
SAMPLE_TEMPERATURE=0.7
MAX_REPAIRS=2
JUDGE_ENABLED=false

# M7: API
AUDIT_LOG_PATH=audit/audit.jsonl
MAX_CONCURRENT_ASKS=4
STRONG_MODEL=

# M9: query cache (0 disables)
CACHE_MAX_ENTRIES=512
CACHE_TTL_SECONDS=3600
